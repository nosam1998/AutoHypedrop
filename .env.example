# Copy to .env and fill in. Every variable is optional; defaults are shown.
# Your Google password is never needed here: you sign in once by hand with
# `autohypedrop login`, and the session lives in the profile directory.

# Where the browser profile, screenshots and traces are kept.
# (The Docker image sets these to /data/profile and /data.)
# AHD_PROFILE_DIR=./data/profile
# AHD_DATA_DIR=./data

# Discord webhook for run notifications. Keep this secret.
# AHD_NOTIFY_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Which outcomes notify: any of claimed, nothing, dry_run, failure.
# AHD_NOTIFY_ON=failure,claimed

# Find claimable boxes but never click (same as `run --dry-run`).
# AHD_DRY_RUN=false

# Headless Chromium. Leave false until Phase 0 shows the site allows it.
# AHD_HEADLESS=false

# Kill switch: any non-empty value (even 0 or false) makes every command exit
# without opening a browser. Creating a file named KILL in AHD_DATA_DIR does the same.
# AHD_KILL_SWITCH=

# Safety caps per run.
# AHD_MAX_CLICKS_PER_RUN=25
# AHD_MAX_PAGE_LOADS_PER_RUN=10

# Random pause between actions, in milliseconds.
# AHD_PACE_MIN_MS=800
# AHD_PACE_MAX_MS=3000

# Timeouts, in milliseconds: page elements, and the box-opening animation.
# AHD_TIMEOUT_MS=20000
# AHD_RESULT_TIMEOUT_MS=30000

# debug, info, warning or error.
# AHD_LOG_LEVEL=info

# Use a different Chromium build than the one bundled with Playwright.
# AHD_CHROMIUM_EXECUTABLE=

# Docker only: the uid/gid that should own files in ./data (run `id` to find yours).
# PUID=1000
# PGID=1000

# Docker only: password for the noVNC login screen. Without one, anyone who can
# reach port 6080 on this machine can use the signed-in browser.
# AHD_VNC_PASSWORD=
