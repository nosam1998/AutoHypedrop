# Copy to .env (`make setup` does this) and fill in what you need.
# Everything here is optional; the defaults are shown.

# --- Schedule (daemon mode) -------------------------------------------------
# Cron expression, in the container's timezone (UTC unless TZ is set).
AHD_SCHEDULE=15 9 * * *
# Random delay of 0..N minutes added to each scheduled run.
AHD_JITTER_MINUTES=30
# TZ=Europe/London

# --- Notifications ----------------------------------------------------------
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL.
AHD_NOTIFY_DISCORD_WEBHOOK=
# Telegram: create a bot with @BotFather; chat id from @userinfobot.
AHD_NOTIFY_TELEGRAM_TOKEN=
AHD_NOTIFY_TELEGRAM_CHAT_ID=
# Which outcomes send a message: claimed, nothing, failure (comma separated).
AHD_NOTIFY_ON=failure,claimed

# --- Behaviour and safety ---------------------------------------------------
# Enumerate free drops but never click open.
AHD_DRY_RUN=false
# Set to any value to make every command exit without touching the browser.
AHD_KILL_SWITCH=
# Hard cap on clicks per run.
AHD_MAX_CLICKS_PER_RUN=25
# Headless Chromium. Leave false unless headless is confirmed not to be challenged.
AHD_HEADLESS=false
# Optional comma separated promo codes to try once each.
AHD_PROMO_CODES=
AHD_LOG_LEVEL=info

# --- Docker -----------------------------------------------------------------
# Image to pull. Pin a release (e.g. v1.0.0) for reproducible deploys.
AHD_IMAGE_TAG=latest
# UID/GID that owns ./data on the host. `make setup` fills in yours.
AHD_UID=1000
AHD_GID=1000
# Host port for the noVNC login screen, and an optional password for it.
AHD_VNC_PORT=6080
AHD_VNC_PASSWORD=

# --- Running without Docker only --------------------------------------------
# Inside Docker these are always /data/profile and /data.
# AHD_PROFILE_DIR=./data/profile
# AHD_DATA_DIR=./data
